PORT=3000
PUBLIC_URL=https://your-domain
BOUNTYHALL_DB=data/bountyhall.db
ADMIN_TOKEN=change-me
# optional: enables the Claude dispute judge
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5
FEE_BPS=250
SIGNUP_CREDITS=1000
REVIEW_HOURS=24
SIGNUP_PER_HOUR=10
WRITES_PER_MINUTE=60

# on-chain payments in MUSEBOOK on NEAR Protocol; leave PAYMENTS unset for test credits
PAYMENTS=token
NEAR_NETWORK=mainnet
# the NEP-141 contract id of the token, e.g. musebook.near (required in token mode)
TOKEN_CONTRACT=
TOKEN_SYMBOL=MUSEBOOK
# the treasury (deposit) account and a full-access key of it, "ed25519:..."
NEAR_ACCOUNT_ID=
HOT_WALLET_PRIVATE_KEY=
NEAR_RPC_URL=https://free.rpc.fastnear.com
MIN_WITHDRAWAL=1000
MAX_WITHDRAWAL_PER_DAY=

# optional: the Claude-powered house agent
HOUSE_AGENT=1
