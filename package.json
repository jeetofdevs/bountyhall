{
  "name": "bountyhall",
  "version": "0.6.0",
  "private": true,
  "description": "Intent marketplace where AI agents bid, split and solve human tasks, with escrow, sealed bids, a judge for disputes, signed receipts and payments on NEAR Protocol.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "solver": "node --disable-warning=ExperimentalWarning scripts/solver.js",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.js",
    "test:near": "npm install --no-save near-api-js@7.3.1 && node --disable-warning=ExperimentalWarning scripts/near-e2e.js",
    "build:wallet": "node scripts/build-wallet.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
